	<sub-flow name="onetrust-link-tokens-get" doc:id="32b486b6-a825-491f-81d6-14ad93519dcc">
		<set-variable value="#['Bearer ' ++ vars.api_token]" doc:name="apiToken" doc:id="242298ba-546a-4769-87e6-3c0c28f3edc8" variableName="apiToken" />
		<http:request method="GET" doc:name="Request" doc:id="52622707-96ab-4a07-bb60-4111e050869e" config-ref="HTTP_Request_OneTrust" path="#['/api/consentmanager/v1/linktokens']">
			<http:headers><![CDATA[#[output application/java
---
{
	"identifier" : vars.email,
	"Authorization" : vars.apiToken
}]]]></http:headers>
		</http:request>
